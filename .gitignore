
# Original private datasets - DO NOT UPLOAD
data/

# Ignore CSV files by default
*.csv

# Allow synthetic deployment datasets
!deployment_data/
!deployment_data/*.csv

# Model files
models/
*.pkl
*.joblib

# Generated reports
reports/

# Python temporary files
__pycache__/
*.pyc

# Virtual environments
venv/
.venv/

# Environment variables and secrets
.env
